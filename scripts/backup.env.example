# Copy to ~/.alodium/backup.env — NEVER commit it, never let it sync to a cloud drive.
#
#   mkdir -p ~/.alodium && chmod 700 ~/.alodium
#   cp scripts/backup.env.example ~/.alodium/backup.env && chmod 600 ~/.alodium/backup.env
#
# scripts/backup.env still works as a fallback for the pre-~/.alodium layout,
# but ~/.alodium is the documented home: it survives re-cloning the checkout.

# ---------------------------------------------------------------------------
# Where the repository lives. P0 is a LOCAL directory on this machine.
# ---------------------------------------------------------------------------
# Be honest about what that buys you: a repository on the same disk as the data
# protects against a bad migration, a dropped database, a deleted volume and
# file corruption. It does NOT survive disk failure, theft or fire. A second
# copy off this disk (external disk, NAS, or B2 via `restic copy`) is P0.5.
export RESTIC_REPOSITORY="$HOME/.alodium/backups/restic"

# Restic's cache. Must live outside every backed-up volume, which is why it has
# its own place under ~/.alodium. Leave this alone unless you have a reason.
export RESTIC_CACHE_DIR="$HOME/.alodium/cache/restic"

# ---------------------------------------------------------------------------
# The passphrase. It is the master key: it decrypts every secret on this node.
# ---------------------------------------------------------------------------
# Preferred — keep it in the macOS Keychain, so no passphrase sits in a file.
# backup.sh runs this command ON THE HOST and hands the result to the restic
# container as a mounted file; it never reaches argv or the container's env.
#
# Create the item once, with a long random passphrase you also write down:
#
#   PASS="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48)"
#   security add-generic-password -a "$USER" -s alodium-restic -w "$PASS"
#   echo "$PASS"    # write this on paper, and keep the paper off this machine
#
# Losing this string loses every backup. restic cannot recover it, and
# `restic key add` cannot retroactively protect what was already written.
export RESTIC_PASSWORD_COMMAND="security find-generic-password -w -s alodium-restic"

# Fallbacks, in the order backup.sh tries them. Use these on hosts with no
# Keychain (a Linux VM, a Windows/WSL2 restore target); prefer that platform's
# secret store over a plaintext file wherever one exists.
#export RESTIC_PASSWORD_FILE="$HOME/.alodium/restic-passphrase"   # chmod 600
#export RESTIC_PASSWORD="CHANGE-ME-long-random-passphrase"

# ---------------------------------------------------------------------------
# Off-site (P0.5 — not the P0 destination). Any restic backend works.
# ---------------------------------------------------------------------------
# Point RESTIC_REPOSITORY at a backend URL and backup.sh forwards these instead
# of bind-mounting a directory. Give the node a key that CANNOT delete (a B2
# application key without deleteFiles, or rest-server --append-only), so a
# compromised agent or ransomware on this box cannot destroy the history;
# `restic forget --prune` then runs separately under an operator-held key.
#export RESTIC_REPOSITORY="b2:your-bucket-name:sovereign-node"
#export B2_ACCOUNT_ID="CHANGE-ME"
#export B2_ACCOUNT_KEY="CHANGE-ME"
