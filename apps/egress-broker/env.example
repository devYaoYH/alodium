# egress-broker — copied to host-only secrets/egress-broker.env by install.sh.
# No downstream API keys — the broker is a generic egress proxy, not a
# single-service gateway. The egress-out companion is the only service on edge.

# Shared by egress-broker and egress-out; generate with openssl rand -hex 32.
# mint:rand-hex-32
EGRESS_EGRESS_TOKEN=

# Dedicated Postgres roles: owner initializes schema; broker writes; dashboard reads.
# mint:rand-hex-32
EGRESS_AUDIT_DB_OWNER_PASSWORD=
# mint:rand-hex-32
EGRESS_AUDIT_DB_WRITER_PASSWORD=
# mint:rand-hex-32
EGRESS_AUDIT_DB_READER_PASSWORD=

# The audit identity for the Ring 0 dashboard. Caddy injects this credential
# server-side, so browsers never learn it. Set in .env; generated with
# openssl rand -hex 32.
# mint:rand-hex-32
EGRESS_AUDIT_TOKEN=

# The agent's credential for POST /v1/egress. Minted by scripts/mint-egress-key.sh
# (operator-only) on a per-task basis; the agent never mints or widens its own
# allowlist. Default empty = broker refuses every call.
# mint:rand-hex-32
AGENT_EGRESS_TOKEN=

# Defense-in-depth allowlist enforced by egress-out on top of the broker's
# per-profile enforcement. Comma-separated host list. mint-egress-key.sh
# appends approved hosts here on a per-exception basis. Default empty = nothing
# leaves egress-out.
EGRESS_ALLOW=

# The broker's a-priori profile (file name under manifest/egress-profiles/).
# An unknown profile name is fatal — the broker refuses to serve. Default
# `default` matches manifest/egress-profiles/default.toml (empty allowlist).
EGRESS_PROFILE=default
