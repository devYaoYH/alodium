# egress-broker — copied to host-only secrets/egress-broker.env by install.sh.
# No downstream API keys — the broker is a generic egress proxy, not a
# single-service gateway. The egress-out companion is the only service on edge.

# Shared by egress-broker and egress-out; generate with openssl rand -hex 32.
# mint:rand-hex-32
EGRESS_EGRESS_TOKEN=

# Dedicated Postgres roles: owner initializes schema; broker writes; dashboard reads.
# mint:rand-hex-32
EGRESS_AUDIT_DB_OWNER_PASSWORD=
# mint:rand-hex-32
EGRESS_AUDIT_DB_WRITER_PASSWORD=
# mint:rand-hex-32
EGRESS_AUDIT_DB_READER_PASSWORD=

# The audit identity for the Ring 0 dashboard. Caddy injects this credential
# server-side, so browsers never learn it. Set in .env; generated with
# openssl rand -hex 32.
# mint:rand-hex-32
EGRESS_AUDIT_TOKEN=
