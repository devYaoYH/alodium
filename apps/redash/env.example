# redash — copied to host-only secrets/redash.env by scripts/install.sh;
# values are auto-generated by scripts/mint-secrets.sh (run by deploy.sh
# before `compose up`) on first deploy, then never rotated. Names only in
# git; no agent ever reads a value.
#
# Redash has no native OIDC, so it needs NO OIDC client of its own: the door
# is the shared oauth2-proxy authshim (its client + cookie secret live in
# root .env, minted by scripts/sso-setup.sh). These are Redash's OWN
# metadata secrets — the cookie/session and the data-source-credential
# encryption key, plus its private postgres password.

# mint:rand-hex-32
REDASH_COOKIE_SECRET=          # signs user sessions; REQUIRED to boot Redash
# mint:rand-hex-32
REDASH_SECRET_KEY=              # encrypts data-source creds stored in the DB
# mint:rand-hex-32
REDASH_DB_PASSWORD=             # postgres password for redash's metadata DB
