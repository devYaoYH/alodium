# redash's door — imported by the root Caddyfile (import apps/*/route.caddy),
# so ring guards and the (authed) snippet are already defined when this loads.
# Ring 1 — the dashboards surface (profile: apps).
#
# Redash has no native OIDC (SAML/Google/LDAP/REMOTE_USER only) and Pocket ID
# speaks OIDC, not SAML — so the door is the oauth2-proxy authshim. A Pocket ID
# passkey is required to reach Redash at all; on success the (authed) snippet
# copies X-Auth-Request-Email into the upstream request. copy_headers
# overwrites any client-supplied value, so the trusted header cannot be
# spoofed past the door (the same guarantee cal/copilot/traces rely on).
#
# Redash only reads that header at /remote_user/login, and its own /login
# page merely offers a "Remote User Login" button. So /login is redirected
# there (keeping ?next=): Redash bounces any session-less request to /login,
# the redirect logs the Pocket ID identity in, and the operator never sees a
# Redash form. Password login is off (compose.yaml), so there is no other way
# in.

dash.{$NODE_DOMAIN} {
	import ring1

	# Complete the passkey callback locally without the forward-auth loop
	# re-inspecting it (same pattern as calino/copilot/traces).
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	handle {
		import authed
		route {
			redir /login /remote_user/login?{query} 302
			reverse_proxy redash-server:5000
		}
	}
}
