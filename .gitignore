.env
scripts/backup.env
manifest/node.yaml
caddy-local-root.crt
caddy/local/*.caddy
authentik-final.sql.gz
**/.DS_Store
config/homepage/logs/
docker-compose.override.yml
.local-ca-bundle.pem
*.swp
*.swo
*~
__pycache__/
.task-dispatch/
.task-sut/
# Per-run agent traces (AGENT_TRACE=1 scripts/run-task.sh): commands and tool
# arguments from real runs — operator-only, never committed. The directory
# itself is tracked (.gitkeep) because Caddy bind-mounts it for traces.<domain>.
traces/*
!traces/.gitkeep

# The skill-discovery symlink IS tracked (global gitignores often exclude
# .claude); everything else under .claude (session state, local settings)
# stays out. The library itself lives in skills/ — framework-agnostic.
!.claude/
.claude/*
!.claude/skills

# Same wiring for forge's project-local harness dir: only the skill-discovery
# symlink is tracked (.forge/skills -> ../skills). Any per-session forge state
# that lands here is the image's business, never a commit in node-config.
.forge/*
!.forge/skills

# Host-only per-app secrets (see docs/SSO.md); node-level keys stay in .env
secrets/
.env.bak-restructure
